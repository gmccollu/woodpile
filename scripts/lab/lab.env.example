# scripts/lab/lab.env: the lab's addresses and ssh aliases. Copy this file to lab.env (gitignored) and fill it in.
# No secrets here: logins are ssh keys in LAB_SSH_CONFIG, and the VM logins have passwordless sudo.

# The ssh config holding every alias below (the VMs usually ProxyJump through the sender host).
LAB_SSH_CONFIG=$HOME/.ssh/woodpile-lab.config
# Results and release assets on the driver (the machine running wl).
LAB_RESULTS=$HOME/woodpile-lab/results
LAB_ASSETS=$HOME/woodpile-lab/assets
# Where `wl fetch TAG` downloads from (needs gh logged in to that host).
LAB_GH_HOST=github.com
LAB_GH_REPO=OWNER/woodshed

# The load source: a Linux host on the targets' subnet. Its login may sudo /opt/woodpile-lab/bin/* (setup-sender).
LAB_SENDER=lab-sender
LAB_SENDER_PARENT=eth0                  # its NIC on the targets' subnet
LAB_SENDER_PREFIX=24                    # that subnet's prefix length
LAB_SENDER_IPS="192.0.2.110 192.0.2.111 192.0.2.112 192.0.2.113 192.0.2.114 192.0.2.115 192.0.2.116 192.0.2.117"
# LAB_SENDER_BIN=/path/to/woodshed-linux-amd64   # default: LAB_ASSETS/tools/woodshed-linux-amd64 (wl tools)

# Targets: LAB_<name>_SSH (alias), _IP (what the senders aim at), _OS (linux|windows), _KIND (deb|rpm|msi).
LAB_TARGETS="ubuntu rhel win"
LAB_ubuntu_SSH=lab-ubuntu
LAB_ubuntu_IP=192.0.2.90
LAB_ubuntu_OS=linux
LAB_ubuntu_KIND=deb
LAB_rhel_SSH=lab-rhel
LAB_rhel_IP=192.0.2.91
LAB_rhel_OS=linux
LAB_rhel_KIND=rpm
LAB_win_SSH=lab-win
LAB_win_IP=192.0.2.92
LAB_win_OS=windows
LAB_win_KIND=msi

# Test sizes (defaults shown).
# LAB_CORRECT_N=100000
# LAB_STRESS_UDP="10000 20000 40000"     # msg/s steps; wl keeps doubling up to LAB_STRESS_MAX until the knee
# LAB_STRESS_TCP="10000 20000 40000"
# LAB_STRESS_SECS=60
# LAB_STRESS_MAX=160000
# LAB_SOAK_RATE=3000
# LAB_SOAK_HOURS=24
# LAB_MSG_SIZE=160
# LAB_FW_ENABLE=1                        # turn an inactive host firewall on (SSH kept open) so the firewall leg means something
# LAB_PORTABLE_PORT=15514
