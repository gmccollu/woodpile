[Unit]
Description=Woodpile syslog server
After=network.target

[Service]
Type=simple
User=woodpile
Group=woodpile
ExecStart=/usr/bin/woodpile run --service --config /etc/woodpile/woodpile.toml
WorkingDirectory=/var/lib/woodpile
Restart=on-failure
RestartSec=5s
UMask=0027
LimitNOFILE=65536

# Port 514 is privileged; this is the only capability the service gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only everywhere except the data and config directories.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/woodpile /etc/woodpile

# Further hardening that a syslog server never needs to relax.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
