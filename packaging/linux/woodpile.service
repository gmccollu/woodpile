[Unit]
Description=Woodpile syslog server
After=network.target

[Service]
Type=simple
User=woodpile
Group=woodpile
ExecStart=/usr/bin/woodpile run --service --config /etc/woodpile/woodpile.toml
WorkingDirectory=/var/lib/woodpile
Restart=on-failure
RestartSec=5s
UMask=0027
LimitNOFILE=65536

# Port 514 is privileged; this is the only capability the service gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only everywhere except the data and config directories.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/woodpile /etc/woodpile

# Further hardening that a syslog server never needs to relax.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
PrivateDevices=yes
MemoryDenyWriteExecute=yes
# IPv4/IPv6 for syslog and the UI, Unix sockets for the journal, netlink to list this
# machine's addresses for the welcome page.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
# Not ProcSubset=pid yet: it hides /proc/net, and the kernel UDP drop counter and the
# "who holds port 514" lookup read /proc/net/udp and /proc/net/tcp. Turn it on once they
# read /proc/self/net/* (visible under ProcSubset=pid).

[Install]
WantedBy=multi-user.target
