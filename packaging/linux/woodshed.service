[Unit]
Description=Woodshed syslog server
After=network.target

[Service]
Type=simple
User=woodshed
Group=woodshed
ExecStart=/usr/bin/woodshed run --service --config /etc/woodshed/woodshed.toml
WorkingDirectory=/var/lib/woodshed
Restart=on-failure
RestartSec=5s
UMask=0027
LimitNOFILE=65536

# Port 514 is privileged; this is the only capability the service gets.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only everywhere except the data and config directories.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/woodshed /etc/woodshed

# Further hardening that a syslog server never needs to relax.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
PrivateDevices=yes
MemoryDenyWriteExecute=yes
# IPv4/IPv6 for syslog and the UI, Unix sockets for the journal, netlink to list this
# machine's addresses for the welcome page.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectProc=invisible
# Only the process directories in /proc. /proc/net is hidden, so the socket tables (kernel
# UDP drops, who holds port 514) are read from /proc/self/net/*, which stays visible.
ProcSubset=pid

[Install]
WantedBy=multi-user.target
