<?xml version="1.0" encoding="utf-8"?>
<!--
  Woodshed MSI (WiX v5). Built by build-msi.ps1:

    wix build -arch x64|arm64 -ext WixToolset.Util.wixext -ext WixToolset.Firewall.wixext
              -d Version=1.2.3 -d BinDir=<dir holding woodshed.exe> -o woodshed.msi woodshed.wxs

  What it does:
  - Installs woodshed.exe (with LICENSE.txt and THIRD_PARTY_NOTICES.txt) per machine to
    Program Files\Woodshed and adds that folder to PATH.
  - Installs the "Woodshed" service, auto start, running as the virtual account NT SERVICE\Woodshed,
    restarted on failure.
  - Creates C:\ProgramData\Woodshed, writable only by that account (Administrators and SYSTEM keep
    full control; ordinary users get no access).
  - Opens the firewall for woodshed.exe on UDP 514 and TCP 514 only. The UI port (8514) is
    localhost-only by default and is not opened.
  - Registers the "Woodshed" event source in the Application log, and a Start menu shortcut to the UI.
  - Upgrades in place (MajorUpgrade). Uninstall keeps C:\ProgramData\Woodshed unless DELETE_LOGS=1:
      msiexec /x woodshed.msi DELETE_LOGS=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <?ifndef Version?>
    <?define Version = 0.0.0?>
  <?endif?>
  <?ifndef BinDir?>
    <?define BinDir = ..\..\dist\windows\amd64?>
  <?endif?>
  <?ifndef CommitTime?>
    <?define CommitTime = 1?>
  <?endif?>
  <?ifndef ProjectUrl?>
    <?define ProjectUrl = https://github.com/gmccollu/woodshed?>
  <?endif?>

  <!-- UpgradeCode never changes: it is how Windows Installer recognises every Woodshed version,
       and every Woodpile one (the old name, release candidates only). Installing Woodshed over a
       Woodpile MSI is a major upgrade: the old product is removed first, and its own uninstall
       stops and deletes the "Woodpile" service (its ServiceControl has Remove="uninstall"), its
       firewall rules, event source and Start-menu shortcut. C:\ProgramData\Woodpile is kept, as
       on any uninstall without DELETE_LOGS=1; `woodshed status` says where it is. -->
  <Package Name="Woodshed"
           Manufacturer="Woodshed"
           Version="$(var.Version)"
           UpgradeCode="ABEA0DF1-F74D-4647-AF6D-FA7E15595FB4"
           Scope="perMachine"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: the MSI version drops a release candidate's suffix, so
         0.9.0-rc4 and 0.9.0-rc3 (or Woodshed and an old Woodpile of the same base version) are
         both 0.9.0. Without it the newer one installs beside the old instead of replacing it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="$(var.ProjectUrl)" />
    <Property Id="ARPHELPLINK" Value="$(var.ProjectUrl)" />
    <!-- Settings > Apps shows the woodshed icon. -->
    <Icon Id="woodshed.ico" SourceFile="$(var.BinDir)\woodshed.ico" />
    <Property Id="ARPPRODUCTICON" Value="woodshed.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- msiexec /x ... DELETE_LOGS=1 also deletes C:\ProgramData\Woodshed (logs, index, config). -->
    <Property Id="DELETE_LOGS" Secure="yes" />

    <!-- RemoveFolderEx runs before CostInitialize, when directory properties aren't resolved yet,
         so give it the path from a system folder property (set at startup) instead. -->
    <SetProperty Id="WOODSHED_DATA_PATH" Value="[CommonAppDataFolder]Woodshed\" After="AppSearch" Sequence="execute" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Woodshed">
        <Component Id="WoodshedExe">
          <File Id="WoodshedExe" Source="$(var.BinDir)\woodshed.exe" KeyPath="yes">
            <fw:FirewallException Id="FwSyslogUdp"
                                  Name="Woodshed syslog (UDP 514)"
                                  Description="Lets devices send syslog to Woodshed over UDP."
                                  Protocol="udp" Port="514" Scope="any" Profile="all" />
            <fw:FirewallException Id="FwSyslogTcp"
                                  Name="Woodshed syslog (TCP 514)"
                                  Description="Lets devices send syslog to Woodshed over TCP."
                                  Protocol="tcp" Port="514" Scope="any" Profile="all" />
          </File>

          <ServiceInstall Id="WoodshedService"
                          Name="Woodshed"
                          DisplayName="Woodshed syslog server"
                          Description="Receives syslog on port 514 and stores it as plain files. UI: http://127.0.0.1:8514/"
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="NT SERVICE\Woodshed"
                          Arguments="run --service --config &quot;[CommonAppDataFolder]Woodshed\woodshed.toml&quot;"
                          Vital="yes">
            <!-- Count a non-zero exit as a failure too, not only a crash. The service keeps only the
                 privileges it needs (bypass traverse checking); everything else a virtual account
                 normally gets, SeImpersonatePrivilege included, is removed from its token. -->
            <ServiceConfig FailureActionsWhen="failedToStopOrReturnedError" OnInstall="yes" OnReinstall="yes">
              <RequiredPrivilege Name="SeChangeNotifyPrivilege" />
            </ServiceConfig>
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="WoodshedServiceControl" Name="Woodshed" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

          <Environment Id="WoodshedPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />

          <!-- Event source "Woodshed" in the Application log. Registering it needs admin rights, which the
               service account doesn't have. Same registration as golang.org/x/sys/windows/svc/eventlog
               InstallAsEventCreate, so the Go side can open it with eventlog.Open("Woodshed"). -->
          <util:EventSource Name="Woodshed" Log="Application"
                            EventMessageFile="%SystemRoot%\System32\EventCreate.exe"
                            SupportsErrors="yes" SupportsWarnings="yes" SupportsInformationals="yes" />
        </Component>

        <!-- Woodshed's license and the third-party notices (generated by scripts/third_party_notices.py). -->
        <Component Id="LicenseTxt">
          <File Id="LicenseTxt" Source="$(var.BinDir)\LICENSE.txt" KeyPath="yes" />
        </Component>
        <!-- The woodshed icon, for the Start-menu shortcut (woodshed.exe has no icon resource). -->
        <Component Id="WoodshedIco">
          <File Id="WoodshedIco" Source="$(var.BinDir)\woodshed.ico" KeyPath="yes" />
        </Component>
        <Component Id="ThirdPartyNotices">
          <File Id="ThirdPartyNotices" Source="$(var.BinDir)\THIRD_PARTY_NOTICES.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="Woodshed">
        <!-- Not Permanent: Windows Installer removes the folder on uninstall only if it is empty,
             so the logs keep it. RemoveFolderEx deletes it with its contents when DELETE_LOGS=1. -->
        <Component Id="DataFolder" Guid="2B9EA838-C213-4D76-8AC8-EF7E9FA0DE00">
          <CreateFolder>
            <!-- Protected DACL (nothing inherited from ProgramData, so no BUILTIN\Users access):
                 SYSTEM and Administrators full control; NT SERVICE\Woodshed modify (read, write,
                 delete, no permission changes). The service SID is S-1-5-80-<SHA-1 of "WOODSHED">,
                 fixed for the service name, so the ACL doesn't depend on the service existing yet. -->
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-246480601-2135328064-241538422-929878615-662582935)" />
          </CreateFolder>
          <util:RemoveFolderEx Id="RemoveDataFolder" On="uninstall" Property="WOODSHED_DATA_PATH"
                               Condition="DELETE_LOGS = 1 AND NOT UPGRADINGPRODUCTCODE" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Reset the ACL of C:\ProgramData\Woodshed and everything already in it (an upgrade's logs, or
         a folder someone created before the install): owner Administrators, the protected DACL above
         on the folder, and only inherited ACEs below it. Links and extra hard-link names inside are
         deleted, never followed, and a data folder that is itself a link fails the install.
         A folder that exists but isn't owned by SYSTEM, Administrators or TrustedInstaller (an ordinary
         user created it first) is renamed aside to Woodshed.untrusted-<UTC time>, contents kept, and a
         fresh one is made; if it can't be moved (in use), the install fails saying so.
         woodshed-aclfix.exe is winacl.PrepareDataDir (internal/winacl), the same code and SDDL as
         `woodshed install`. It runs from the Binary table as SYSTEM before CreateFolders (whose
         PermissionEx would already make Administrators the owner) and so before the service starts,
         on install, upgrade and repair, but not on uninstall. -->
    <Binary Id="WoodshedAclFix" SourceFile="$(var.BinDir)\woodshed-aclfix.exe" />
    <!-- Installed files get the release commit's time (CommitTime, Unix seconds UTC). A cabinet
         stores zone-less local times that Windows Installer applies as the target's local time,
         so without this they're off by the target's UTC offset (hours in the future west of UTC).
         "[INSTALLFOLDER]." avoids a trailing backslash before the closing quote. Cosmetic: ignored
         if it fails. -->
    <CustomAction Id="WoodshedFileTimes" BinaryRef="WoodshedAclFix"
                  ExeCommand="--file-times &quot;[INSTALLFOLDER].&quot; $(var.CommitTime)"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="WoodshedResetDataAcl" BinaryRef="WoodshedAclFix"
                  ExeCommand="&quot;[CommonAppDataFolder]Woodshed&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="WoodshedResetDataAcl" Before="CreateFolders" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="WoodshedFileTimes" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="6BB62F0D-FF73-4D85-B2A8-73574572546F">
        <util:InternetShortcut Id="WoodshedUiShortcut" Directory="ProgramMenuFolder" Name="Woodshed"
                               Target="http://127.0.0.1:8514/" Type="url" IconFile="[#WoodshedIco]" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Woodshed" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Woodshed" Level="1">
      <ComponentRef Id="WoodshedExe" />
      <ComponentRef Id="LicenseTxt" />
      <ComponentRef Id="ThirdPartyNotices" />
      <ComponentRef Id="WoodshedIco" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
