<?xml version="1.0" encoding="utf-8"?>
<!--
  Woodpile MSI (WiX v5). Built by build-msi.ps1:

    wix build -arch x64|arm64 -ext WixToolset.Util.wixext -ext WixToolset.Firewall.wixext
              -d Version=1.2.3 -d BinDir=<dir holding woodpile.exe> -o woodpile.msi woodpile.wxs

  What it does:
  - Installs woodpile.exe per machine to Program Files\Woodpile and adds that folder to PATH.
  - Installs the "Woodpile" service, auto start, running as the virtual account NT SERVICE\Woodpile,
    restarted on failure.
  - Creates C:\ProgramData\Woodpile, writable only by that account (Administrators and SYSTEM keep
    full control; ordinary users get no access).
  - Opens the firewall for woodpile.exe on UDP 514 and TCP 514 only. The UI port (8514) is
    localhost-only by default and is not opened.
  - Registers the "Woodpile" event source in the Application log, and a Start menu shortcut to the UI.
  - Upgrades in place (MajorUpgrade). Uninstall keeps C:\ProgramData\Woodpile unless DELETE_LOGS=1:
      msiexec /x woodpile.msi DELETE_LOGS=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <?ifndef Version?>
    <?define Version = 0.0.0?>
  <?endif?>
  <?ifndef BinDir?>
    <?define BinDir = ..\..\dist\windows\amd64?>
  <?endif?>
  <?ifndef ProjectUrl?>
    <?define ProjectUrl = https://github.com/OWNER/woodpile?>
  <?endif?>

  <!-- UpgradeCode never changes: it is how Windows Installer recognises every Woodpile version. -->
  <Package Name="Woodpile"
           Manufacturer="Woodpile"
           Version="$(var.Version)"
           UpgradeCode="ABEA0DF1-F74D-4647-AF6D-FA7E15595FB4"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="$(var.ProjectUrl)" />
    <Property Id="ARPHELPLINK" Value="$(var.ProjectUrl)" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- msiexec /x ... DELETE_LOGS=1 also deletes C:\ProgramData\Woodpile (logs, index, config). -->
    <Property Id="DELETE_LOGS" Secure="yes" />

    <!-- RemoveFolderEx runs before CostInitialize, when directory properties aren't resolved yet,
         so give it the path from a system folder property (set at startup) instead. -->
    <SetProperty Id="WOODPILE_DATA_PATH" Value="[CommonAppDataFolder]Woodpile\" After="AppSearch" Sequence="execute" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Woodpile">
        <Component Id="WoodpileExe">
          <File Id="WoodpileExe" Source="$(var.BinDir)\woodpile.exe" KeyPath="yes">
            <fw:FirewallException Id="FwSyslogUdp"
                                  Name="Woodpile syslog (UDP 514)"
                                  Description="Lets devices send syslog to Woodpile over UDP."
                                  Protocol="udp" Port="514" Scope="any" Profile="all" />
            <fw:FirewallException Id="FwSyslogTcp"
                                  Name="Woodpile syslog (TCP 514)"
                                  Description="Lets devices send syslog to Woodpile over TCP."
                                  Protocol="tcp" Port="514" Scope="any" Profile="all" />
          </File>

          <ServiceInstall Id="WoodpileService"
                          Name="Woodpile"
                          DisplayName="Woodpile syslog server"
                          Description="Receives syslog on port 514 and stores it as plain files. UI: http://127.0.0.1:8514/"
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="NT SERVICE\Woodpile"
                          Arguments="run --service --config &quot;[CommonAppDataFolder]Woodpile\woodpile.toml&quot;"
                          Vital="yes">
            <!-- Count a non-zero exit as a failure too, not only a crash. -->
            <ServiceConfig FailureActionsWhen="failedToStopOrReturnedError" OnInstall="yes" OnReinstall="yes" />
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="WoodpileServiceControl" Name="Woodpile" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

          <Environment Id="WoodpilePath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />

          <!-- Event source "Woodpile" in the Application log. Registering it needs admin rights, which the
               service account doesn't have. Same registration as golang.org/x/sys/windows/svc/eventlog
               InstallAsEventCreate, so the Go side can open it with eventlog.Open("Woodpile"). -->
          <util:EventSource Name="Woodpile" Log="Application"
                            EventMessageFile="%SystemRoot%\System32\EventCreate.exe"
                            SupportsErrors="yes" SupportsWarnings="yes" SupportsInformationals="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="Woodpile">
        <!-- Not Permanent: Windows Installer removes the folder on uninstall only if it is empty,
             so the logs keep it. RemoveFolderEx deletes it with its contents when DELETE_LOGS=1. -->
        <Component Id="DataFolder" Guid="FD729DDF-D767-46AD-A57F-F7DE14E2CA7C">
          <CreateFolder>
            <!-- Protected DACL (nothing inherited from ProgramData, so no BUILTIN\Users access):
                 SYSTEM and Administrators full control; NT SERVICE\Woodpile modify (read, write,
                 delete, no permission changes). The service SID is S-1-5-80-<SHA-1 of "WOODPILE">,
                 fixed for the service name, so the ACL doesn't depend on the service existing yet. -->
            <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-276366627-2944175572-1807786847-528126453-1705305312)" />
          </CreateFolder>
          <util:RemoveFolderEx Id="RemoveDataFolder" On="uninstall" Property="WOODPILE_DATA_PATH"
                               Condition="DELETE_LOGS = 1 AND NOT UPGRADINGPRODUCTCODE" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="F57B1F2E-A19F-421B-AD0D-5942E741BEA4">
        <util:InternetShortcut Id="WoodpileUiShortcut" Directory="ProgramMenuFolder" Name="Woodpile"
                               Target="http://127.0.0.1:8514/" Type="url" />
        <RegistryValue Root="HKLM" Key="Software\Woodpile" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Woodpile" Level="1">
      <ComponentRef Id="WoodpileExe" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
